typ x = Int;
val y : Int = 10;
typ add = (Int, Int) -> Int;


val Box
  : Type -> Type
  = forall R : Type . (T -> R) -> R end;

val box
  : forall T : Type . T -> Box T end
  = fun <T: Type>(x: T) =>
      fun<R: Type>(k: T -> R) =>
        k x
      end
    end;

val Pair
  : (Type, Type) -> Type
  = fun<A: Type, B: Type> =>
      forall R : Type . ((A , B) -> R) -> R end
    end;

val pair
  : forall A: Type, B: Type . (A, B) -> Pair A B end
  = fun<A: Type, B: Type>(a: A, b: B) =>
      fun<R: Type>(k: (A, B) -> R) =>
        k a b
      end
    end;

val Option 
  : Type -> Type
  = fun<T: Type> => forall R : Type . (T -> R, R) -> R end end;

val none
  : forall T : Type . Option T end
  = fun<R: Type>(s: T -> R, n: R) => n end;

val some
  : forall T : Type . T -> Option T end
  = fun<T: Type>(x : T) =>
      fun<R: Type>(s: T -> R, n: R) =>
        s x
      end
    end;

typ ret
  = forall M : Type -> Type, A : Type .
      A -> M A
    end;
typ bind
  = forall M : Type -> Type, A : Type, B : Type .
    (M A, A -> M B) -> M B
  end;
