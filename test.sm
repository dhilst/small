typ x = Int;
val y : Int = 10;
typ add = (Int, Int) -> Int;

val Box
  : Type -> Type
  = forall R : Type . (T -> R) -> R end;

val box
  : forall T : Type . T -> Box<T> end
  = fun <T: Type>(x: T) =>
      fun<R: Type>(k: T -> R) =>
        k(x)
      end
    end;
 
val Pair
  : (Type, Type) -> Type
  = fun<A: Type, B: Type> =>
      forall R : Type . ((A , B) -> R) -> R end
    end;
 
val pair
  : forall A: Type, B: Type . (A, B) -> Pair<A, B> end
  = fun<A: Type, B: Type>(a: A, b: B) =>
      fun<R: Type>(k: (A, B) -> R) =>
        k(a,b)
      end
    end;

val Option 
  : Type -> Type
  = fun<T: Type> => forall R : Type . (T -> R, R) -> R end end;

val none
  : forall T : Type . Option<T> end
  = fun<R: Type>(s: T -> R, n: R) => n end;

val some
  : forall T : Type . T -> Option<T> end
  = fun<T: Type>(x : T) =>
      fun<R: Type>(s: T -> R, n: R) =>
        s(x)
      end
    end;

# Monad types
val Ret
  : (Type -> Type, Type) -> Type
  = fun<M: Type -> Type, A: Type> =>
      A -> M<A>
    end;

val Bind
  : (Type -> Type, Type) -> Type
  = fun<M: Type -> Type, A: Type> =>
      forall B : Type .
        (M<A>, A -> M<B>) -> M<B>
      end
    end;

val Monad 
  : (Type -> Type, Type) -> Type
  = fun<M: Type -> Type, A: Type> =>
      Pair<
        Ret<M, A>,                         
        Bind<M, A>
      >
    end;

# Monad constructor and projections
val monad
  : forall M : Type -> Type, A : Type . (Ret<M, A>, Bind<M, A>) -> Monad<M, A> end
  = fun<M : Type -> Type, A : Type>(ret: Ret<M, A>, bind: Bind<M, A>) =>
      pair<Ret<M, A>, Bind<M, A>>(ret, bind)
    end;

val ret
  : forall M : Type -> Type, A : Type . Monad<M, A> -> (A -> M<A>) end
  = fun<M : Type -> Type, A : Type>(m : Monad<M, A>) =>
      m(fun(fst: Ret<M, A>, snd: Bind<M, A>) => fst end)
    end;

val bind
  : forall M : Type -> Type, A : Type . Bind<M, A> end
  = fun<M : Type -> Type, A : Type>(m : Monad<M, A>) =>
      m(fun(fst: Ret<M, A>, snd: Bind<M, A>) => snd end)
    end;


val opt_monad
  : forall A : Type . Monad<Option, A> end
  = fun<A : Type> =>
      pair<
        A -> Option<A>,
        forall B : Type . (Option<A>, A -> Option<B>) -> Option<B> end
      >(
        # ret
        fun(x : A) =>
          some<A>(x)
        end, 
        # bind
        fun<B : Type>(ma: Option<A>, k: A -> Option<B>) =>
          ma<A>(
            fun(x : A) => k(x) end, # some x
            none<B>                 # none
          )
        end
      )
    end;
      

